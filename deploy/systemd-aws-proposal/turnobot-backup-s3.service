[Unit]
Description=TurnoBot - Subida del backup PostgreSQL a S3
After=turnobot-backup.service
OnFailure=turnobot-failure-notify@%N.service
# No Requires/Wants desde turnobot-backup: el disparo es via ExecStartPost
# solo cuando el backup local termino con exito.

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/turnobot
Environment=PYTHONPATH=/home/ubuntu/turnobot
UMask=0077
# Sube backups validos mas recientes primero. Omite los ya confirmados por
# marcador en /home/ubuntu/turnobot/state/s3_backup_uploads/. Si un upload
# falla, continua con los pendientes restantes y sale con error al final.
ExecStart=/bin/bash -c 'set -euo pipefail; dir=/home/ubuntu/turnobot/backups_pg; state=/home/ubuntu/turnobot/state/s3_backup_uploads; py=/home/ubuntu/turnobot/.venv312/bin/python; mkdir -p "$state"; shopt -s nullglob; pending=(); for f in "$dir"/turnobot-pg-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].dump; do [ -L "$f" ] && continue; [ -f "$f" ] || continue; [ -s "$f" ] || continue; base="$(basename "$f")"; marker="$state/${base}.uploaded"; [ -f "$marker" ] && continue; pending+=("$f"); done; if [ ${#pending[@]} -eq 0 ]; then echo "S3_UPLOAD_PENDING=0"; exit 0; fi; failed=0; uploaded=0; for ((i=${#pending[@]}-1; i>=0; i--)); do f="${pending[$i]}"; echo "S3_UPLOAD_PENDING=${#pending[@]} uploading=$(basename "$f")"; if "$py" /home/ubuntu/turnobot/scripts/upload_s3_backup.py "$f" --state-dir "$state"; then uploaded=$((uploaded+1)); else echo "S3_ERROR upload_failed file=$f" >&2; failed=$((failed+1)); fi; done; echo "S3_UPLOAD_SUMMARY uploaded=$uploaded failed=$failed pending_initial=${#pending[@]}"; [ "$failed" -eq 0 ]'
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
