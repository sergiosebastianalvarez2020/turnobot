[Unit]
Description=TurnoBot - Subida del backup PostgreSQL a S3
After=turnobot-backup.service
OnFailure=turnobot-failure-notify@%N.service
# No Requires/Wants desde turnobot-backup: el disparo es via ExecStartPost
# solo cuando el backup local termino con exito.

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/turnobot
Environment=PYTHONPATH=/home/ubuntu/turnobot
UMask=0077
# Sube backups validos mas recientes primero. Omite los ya confirmados por
# marcador en /home/ubuntu/turnobot/state/s3_backup_uploads/. Si un upload
# falla, continua con los pendientes restantes y sale con error al final.
# Valida marcadores con la misma lógica que is_upload_done(): SHA-256 64 hex + s3:// URI
# que coincida exactamente con el bucket y la clave esperados para cada dump.
ExecStart=/bin/bash -c 'set -euo pipefail; dir=/home/ubuntu/turnobot/backups_pg; state=/home/ubuntu/turnobot/state/s3_backup_uploads; py=/home/ubuntu/turnobot/.venv312/bin/python; mkdir -p "$state"; shopt -s nullglob; pending=(); for f in "$dir"/turnobot-pg-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].dump; do [ -L "$f" ] && continue; [ -f "$f" ] || continue; [ -s "$f" ] || continue; base="$(basename "$f")"; marker="$state/${base}.uploaded"; if "$py" -c "import sys; sys.path.insert(0, \"/home/ubuntu/turnobot\"); from scripts.upload_s3_backup import validate_marker_file; from pathlib import Path; sys.exit(0 if validate_marker_file(Path(sys.argv[1]), Path(sys.argv[2])) else 1)" "$marker" "$f"; then continue; fi; pending+=("$f"); done; if [ ${#pending[@]} -eq 0 ]; then echo "S3_UPLOAD_PENDING=0"; exit 0; fi; failed=0; uploaded=0; for ((i=${#pending[@]}-1; i>=0; i--)); do f="${pending[$i]}"; echo "S3_UPLOAD_PENDING=${#pending[@]} uploading=$(basename "$f")"; if "$py" /home/ubuntu/turnobot/scripts/upload_s3_backup.py "$f" --state-dir "$state"; then uploaded=$((uploaded+1)); else echo "S3_ERROR upload_failed file=$f" >&2; failed=$((failed+1)); fi; done; echo "S3_UPLOAD_SUMMARY uploaded=$uploaded failed=$failed pending_initial=${#pending[@]}"; [ "$failed" -eq 0 ]'
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
