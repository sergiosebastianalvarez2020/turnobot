[Unit]
Description=TurnoBot - Recordatorios de turnos por email
After=network.target
OnFailure=turnobot-failure-notify@%N.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/turnobot
EnvironmentFile=/etc/turnobot.env
EnvironmentFile=/etc/turnobot-monitoring.env
Environment=PYTHONPATH=/home/ubuntu/turnobot
ExecStart=/home/ubuntu/turnobot/.venv312/bin/python /home/ubuntu/turnobot/scripts/send_reminders.py
NoNewPrivileges=true
PrivateTmp=true
