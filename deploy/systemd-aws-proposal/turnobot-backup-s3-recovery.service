[Unit]
Description=TurnoBot - Recuperación de backups S3 pendientes
# Timer asociado: turnobot-backup-s3-recovery.timer (cada 30 min)
# No requiere red inmediata; OnFailure notifica si falla la recuperación.
OnFailure=turnobot-failure-notify@%N.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/turnobot
Environment=PYTHONPATH=/home/ubuntu/turnobot
UMask=0077
# Lock exclusivo que protege TODO el proceso de recuperación.
# flock -n -E 75: si el lock está ocupado, sale con código 75.
# flock se ejecuta DENTRO de un `if` para que `set -e` no aborte el wrapper
# antes de capturar el código: si se ejecutara como comando suelto, un 75
# terminaría el bash inmediatamente y nunca se convertiría en 0.
# El wrapper bash convierte: 75 -> 0 (lock ocupado, sin alerta OnFailure),
# 0 -> 0 (éxito), otro -> propaga el error para activar OnFailure.
# El drop-in del backup local usa "|| true", así que un fallo por lock no
# convierte el backup local exitoso en fallido ni dispara OnFailure.
# Los pendientes se recuperan en la siguiente ejecución (timer diario o timer
# de recuperación cada 30 min).
ExecStart=/bin/bash -c 'set -euo pipefail; if /usr/bin/flock -n -E 75 /run/lock/turnobot-s3-upload.lock /bin/bash -c "set -euo pipefail; dir=/home/ubuntu/turnobot/backups_pg; state=/home/ubuntu/turnobot/state/s3_backup_uploads; py=/home/ubuntu/turnobot/.venv312/bin/python; mkdir -p \"$state\"; shopt -s nullglob; pending=(); for f in \"$dir\"/turnobot-pg-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].dump; do [ -L \"$f\" ] && continue; [ -f \"$f\" ] || continue; [ -s \"$f\" ] || continue; base=\"$(basename \"$f\")\"; marker=\"$state/${base}.uploaded\"; if \"$py\" -c \"import sys; sys.path.insert(0, \\\"/home/ubuntu/turnobot\\\"); from scripts.upload_s3_backup import validate_marker_file; from pathlib import Path; sys.exit(0 if validate_marker_file(Path(sys.argv[1]), Path(sys.argv[2])) else 1)\" \"$marker\" \"$f\"; then continue; fi; pending+=(\"$f\"); done; if [ ${#pending[@]} -eq 0 ]; then echo \"S3_RECOVERY_PENDING=0\"; exit 0; fi; failed=0; uploaded=0; for ((i=${#pending[@]}-1; i>=0; i--)); do f=\"${pending[$i]}\"; echo \"S3_RECOVERY_PENDING=${#pending[@]} uploading=$(basename \\\"$f\\\")\"; if \"$py\" /home/ubuntu/turnobot/scripts/upload_s3_backup.py \"$f\" --state-dir \"$state\"; then uploaded=$((uploaded+1)); else echo \"S3_ERROR recovery_failed file=$f\" >&2; failed=$((failed+1)); fi; done; echo \"S3_RECOVERY_SUMMARY uploaded=$uploaded failed=$failed pending_initial=${#pending[@]}\"; [ \"$failed\" -eq 0 ]"; then exit 0; else flock_exit=$?; if [ $flock_exit -eq 75 ]; then exit 0; fi; exit $flock_exit; fi'
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true